{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Square",
  "version": "1.2.0",
  "identifier": "io.square.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Square",
        "width": 640,
        "height": 640,
        "minWidth": 640,
        "minHeight": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "wheel",
        "title": "Square · Rueda rápida",
        "url": "index.html?view=wheel",
        "width": 420,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
